---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import Projects from '../components/sections/Projects.astro';
import { SITE_TITLE } from '../consts';
import { author } from '../data/author';
import ArrowSeparator from '../components/ui/separator/ArrowSeparator.astro';
---

<!doctype html>
<html lang="fr" data-theme="dark" class="dark">
  <head>
    <BaseHead title={`Portfolio - ${SITE_TITLE}`} description={`Découvrez l'ensemble des projets réalisés par ${author.name}.`} />
  </head>
  <body>
    <Header />
    <main class="use-utility-layout max-w-6xl mx-auto px-4 py-12">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h1 class="text-3xl md:text-5xl font-extrabold text-[color:var(--color-text-primary)] mb-4">
          <span class="lang-fr">Portfolio & Réalisations</span>
          <span class="lang-en">Portfolio & Projects</span>
        </h1>
        <p class="text-base md:text-lg text-[color:var(--color-text-secondary)] leading-relaxed">
          <span class="lang-fr">
            Découvrez une sélection de projets web récents, d'applications full-stack et d'outils visuels sur-mesure.
          </span>
          <span class="lang-en">
            Explore a curated showcase of recent web applications, full-stack tools, and tailored visual engines.
          </span>
        </p>
      </div>

      <Projects 
        titleFr="Tous les Projets" 
        titleEn="All Projects" 
        subtitleFr="Applications en production, prototypes et projets d'innovation technologique."
        subtitleEn="Production applications, prototypes, and technical innovation projects."
      />
    </main>
    <Footer />
  </body>
</html>
