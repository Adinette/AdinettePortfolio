---
import type { StudyItem } from '../../data/studies';

interface Props {
  titleFr?: string;
  titleEn?: string;
  subtitleFr?: string;
  subtitleEn?: string;
  items: StudyItem[];
}

const {
  titleFr = "Formations & Immersion",
  titleEn = "Education & Internships",
  subtitleFr = "Parcours académique en génie logiciel et montée en compétences continue.",
  subtitleEn = "Academic degree in software engineering and continuous technical learning.",
  items = []
} = Astro.props;
---

<section id="studies" class="py-8">
  <div class="text-center max-w-3xl mx-auto mb-10">
    <h2 class="text-2xl md:text-3xl font-extrabold text-[color:var(--color-text-primary)] tracking-tight mb-2">
      <span class="lang-fr">{titleFr}</span>
      <span class="lang-en">{titleEn}</span>
    </h2>
    <p class="text-sm md:text-base text-[color:var(--color-text-secondary)]">
      <span class="lang-fr">{subtitleFr}</span>
      <span class="lang-en">{subtitleEn}</span>
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {items.map((item) => (
      <div class="card-surface p-6 flex flex-col justify-between hover-lift">
        <div>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/20 inline-block mb-3">
            <span class="lang-fr">{item.periodFr}</span>
            <span class="lang-en">{item.periodEn}</span>
          </span>

          <h3 class="text-lg font-bold text-[color:var(--color-text-primary)] mb-1">
            <span class="lang-fr">{item.titleFr}</span>
            <span class="lang-en">{item.titleEn}</span>
          </h3>

          <p class="text-xs font-medium text-[var(--accent)] mb-3">
            <span class="lang-fr">{item.institutionFr}</span>
            <span class="lang-en">{item.institutionEn}</span>
          </p>

          <p class="text-xs md:text-sm text-[color:var(--color-text-secondary)] leading-relaxed mb-4">
            <span class="lang-fr">{item.descriptionFr}</span>
            <span class="lang-en">{item.descriptionEn}</span>
          </p>
        </div>

        <div class="flex flex-wrap gap-1.5 pt-3 border-t border-[color:var(--color-border-light)]">
          {item.tagsFr.map((tag, idx) => (
            <span class="sw-tag">
              <span class="lang-fr">{tag}</span>
              <span class="lang-en">{item.tagsEn[idx] || tag}</span>
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
