---
import { author } from '../../data/author';
import Button from '../ui/button/Button.astro';

interface CTA {
  textFr: string;
  textEn: string;
  href: string;
}

interface Props {
  title?: string;
  subtitleFr?: string;
  subtitleEn?: string;
  descriptionFr?: string;
  descriptionEn?: string;
  badgeFr?: string;
  badgeEn?: string;
  showCTA?: boolean;
  primaryCTA?: CTA;
  secondaryCTA?: CTA;
  tertiaryCTA?: CTA;
}

const {
  title = author.name,
  subtitleFr = author.title,
  subtitleEn = "Front-End Web Developer",
  descriptionFr = "Créatrice d'interfaces web modernes, intuitives et performantes avec Vue.js 3, React.js, Next.js et TypeScript.",
  descriptionEn = "Crafting modern, intuitive, and performant web interfaces with Vue.js 3, React.js, Next.js, and TypeScript.",
  badgeFr = "Disponible pour opportunités Front-End",
  badgeEn = "Available for Front-End Opportunities",
  showCTA = true,
  primaryCTA = { textFr: 'Découvrir mes projets', textEn: 'Explore Projects', href: '#projects' },
  secondaryCTA = { textFr: 'En savoir plus sur moi', textEn: 'About Me', href: '/about' },
  tertiaryCTA = { textFr: 'Me contacter', textEn: 'Contact Me', href: '#contact' },
} = Astro.props;
---

<section class="py-12 md:py-16 text-center max-w-4xl mx-auto px-4">
  {badgeFr && (
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--accent)]/10 border border-[var(--accent)]/30 text-[var(--accent)] text-xs md:text-sm font-semibold mb-6 shadow-sm backdrop-blur-sm animate-pulse">
      <span class="w-2 h-2 rounded-full bg-[var(--accent)] inline-block"></span>
      <span class="lang-fr">{badgeFr}</span>
      <span class="lang-en">{badgeEn}</span>
    </div>
  )}

  <div class="mb-4">
    <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-[color:var(--color-text-primary)] mb-2">
      {title}
    </h1>
    <h2 class="text-xl md:text-2xl font-bold text-[var(--accent)] tracking-normal">
      <span class="lang-fr">{subtitleFr}</span>
      <span class="lang-en">{subtitleEn}</span>
    </h2>
  </div>

  <p class="text-base md:text-lg text-[color:var(--color-text-secondary)] leading-relaxed max-w-2xl mx-auto mb-8">
    <span class="lang-fr">{descriptionFr}</span>
    <span class="lang-en">{descriptionEn}</span>
  </p>

  {showCTA && (
    <div class="flex flex-wrap items-center justify-center gap-3 md:gap-4">
      {primaryCTA && (
        <Button href={primaryCTA.href} variant="primary" size="md">
          <span class="lang-fr">{primaryCTA.textFr}</span>
          <span class="lang-en">{primaryCTA.textEn}</span>
        </Button>
      )}
      {secondaryCTA && (
        <Button href={secondaryCTA.href} variant="outline" size="md">
          <span class="lang-fr">{secondaryCTA.textFr}</span>
          <span class="lang-en">{secondaryCTA.textEn}</span>
        </Button>
      )}
      {tertiaryCTA && (
        <Button href={tertiaryCTA.href} variant="ghost" size="md">
          <span class="lang-fr">{tertiaryCTA.textFr}</span>
          <span class="lang-en">{tertiaryCTA.textEn}</span>
        </Button>
      )}
    </div>
  )}
</section>
