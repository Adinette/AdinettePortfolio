---
import { projects } from '../../data/projects';

interface Props {
  titleFr?: string;
  titleEn?: string;
  subtitleFr?: string;
  subtitleEn?: string;
}

const {
  titleFr = "Projets & Réalisations Clés",
  titleEn = "Featured Projects & Key Work",
  subtitleFr = "Une sélection d'applications web full-stack, d'outils no-code et de plateformes déployées en production.",
  subtitleEn = "A curated selection of full-stack web applications, no-code visual tools, and deployed production platforms."
} = Astro.props;
---

<section id="projects" class="py-8">
  <div class="text-center max-w-3xl mx-auto mb-10">
    <h2 class="text-2xl md:text-3xl font-extrabold text-[color:var(--color-text-primary)] tracking-tight mb-2">
      <span class="lang-fr">{titleFr}</span>
      <span class="lang-en">{titleEn}</span>
    </h2>
    <p class="text-sm md:text-base text-[color:var(--color-text-secondary)]">
      <span class="lang-fr">{subtitleFr}</span>
      <span class="lang-en">{subtitleEn}</span>
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {projects.map((project) => (
      <div class="card-surface p-6 flex flex-col justify-between hover-lift relative overflow-hidden group">
        <div>
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="sw-tag font-semibold text-[var(--accent)] bg-[var(--accent)]/10 border border-[var(--accent)]/20">
              <span class="lang-fr">{project.badgeFr || "Projet"}</span>
              <span class="lang-en">{project.badgeEn || "Project"}</span>
            </span>
          </div>

          <h3 class="text-xl font-bold text-[color:var(--color-text-primary)] mb-1 group-hover:text-[var(--accent)] transition-colors">
            <span class="lang-fr">{project.titleFr}</span>
            <span class="lang-en">{project.titleEn}</span>
          </h3>

          {(project.subtitleFr || project.subtitleEn) && (
            <p class="text-xs font-medium text-[var(--accent)] mb-3">
              <span class="lang-fr">{project.subtitleFr}</span>
              <span class="lang-en">{project.subtitleEn}</span>
            </p>
          )}

          <p class="text-sm text-[color:var(--color-text-secondary)] leading-relaxed mb-4">
            <span class="lang-fr">{project.descriptionFr}</span>
            <span class="lang-en">{project.descriptionEn}</span>
          </p>

          {(project.highlightsFr || project.highlightsEn) && (
            <ul class="text-xs text-[color:var(--color-text-secondary)] space-y-1.5 mb-4 pl-4 list-disc">
              {project.highlightsFr?.map((item, idx) => (
                <li class="lang-fr">{item}</li>
              ))}
              {project.highlightsEn?.map((item, idx) => (
                <li class="lang-en">{item}</li>
              ))}
            </ul>
          )}
        </div>

        <div class="pt-4 border-t border-[color:var(--color-border-light)] mt-auto flex items-center justify-between flex-wrap gap-2">
          <span class="text-xs font-mono text-[color:var(--color-text-secondary)]">
            {project.techStack}
          </span>
          {project.ctaLink && (
            <a
              href={project.ctaLink}
              class="inline-flex items-center gap-1 text-xs font-semibold text-[var(--accent)] hover:underline no-underline"
            >
              <span class="lang-fr">{project.ctaTextFr}</span>
              <span class="lang-en">{project.ctaTextEn}</span>
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
