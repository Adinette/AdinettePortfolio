---
import type { SkillCategory } from '../../data/skills';

interface Props {
  titleFr?: string;
  titleEn?: string;
  subtitleFr?: string;
  subtitleEn?: string;
  skills: SkillCategory[];
}

const {
  titleFr = "Compétences Techniques & Outils",
  titleEn = "Technical Skills & Stack",
  subtitleFr = "Une vue exhaustive de l'écosystème technique et des technologies manipulées au quotidien.",
  subtitleEn = "A comprehensive view of the technical ecosystem and tools mastered day-to-day.",
  skills = []
} = Astro.props;
---

<section id="skills" class="py-8">
  <div class="text-center max-w-3xl mx-auto mb-10">
    <h2 class="text-2xl md:text-3xl font-extrabold text-[color:var(--color-text-primary)] tracking-tight mb-2">
      <span class="lang-fr">{titleFr}</span>
      <span class="lang-en">{titleEn}</span>
    </h2>
    <p class="text-sm md:text-base text-[color:var(--color-text-secondary)]">
      <span class="lang-fr">{subtitleFr}</span>
      <span class="lang-en">{subtitleEn}</span>
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {skills.map((item) => (
      <div class="card-surface p-6 flex flex-col justify-between hover-lift">
        <div>
          <div class="w-10 h-10 rounded-xl bg-[var(--accent)]/10 text-[var(--accent)] flex items-center justify-center mb-4 p-2">
            <Fragment set:html={item.icon} />
          </div>

          <h3 class="text-lg font-bold text-[color:var(--color-text-primary)] mb-2">
            <span class="lang-fr">{item.titleFr}</span>
            <span class="lang-en">{item.titleEn}</span>
          </h3>

          <p class="text-xs md:text-sm text-[color:var(--color-text-secondary)] leading-relaxed mb-4">
            <span class="lang-fr">{item.descriptionFr}</span>
            <span class="lang-en">{item.descriptionEn}</span>
          </p>
        </div>

        <div class="flex flex-wrap gap-1.5 pt-3 border-t border-[color:var(--color-border-light)]">
          {item.tags.map((tag) => (
            <span class="sw-tag">
              {tag}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
