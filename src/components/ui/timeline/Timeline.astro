---
interface TimelineItem {
  titleFr: string;
  titleEn: string;
  company: string;
  regionFr: string;
  regionEn: string;
  periodFr: string;
  periodEn: string;
  descriptionFr: string;
  descriptionEn: string;
  technologies: string[];
}

interface Props {
  items: TimelineItem[];
}

const { items = [] } = Astro.props;
---

<div class="relative border-l-2 border-[var(--accent)]/30 ml-4 md:ml-6 space-y-8 py-2">
  {items.map((item, index) => (
    <div class="relative pl-6 md:pl-8 group">
      <!-- Bullet node on timeline line -->
      <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-[var(--color-bg-primary)] border-2 border-[var(--accent)] group-hover:bg-[var(--accent)] transition-colors"></div>

      <div class="card-surface p-5 md:p-6 hover-lift">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-1 mb-2">
          <h3 class="text-lg md:text-xl font-bold text-[color:var(--color-text-primary)]">
            <span class="lang-fr">{item.titleFr}</span>
            <span class="lang-en">{item.titleEn}</span>
          </h3>

          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/20 w-fit">
            <span class="lang-fr">{item.periodFr}</span>
            <span class="lang-en">{item.periodEn}</span>
          </span>
        </div>

        <div class="flex items-center gap-2 text-xs md:text-sm font-medium text-[var(--accent)] mb-3">
          <span class="font-bold text-[color:var(--color-text-primary)]">{item.company}</span>
          <span>•</span>
          <span class="lang-fr">{item.regionFr}</span>
          <span class="lang-en">{item.regionEn}</span>
        </div>

        <p class="text-xs md:text-sm text-[color:var(--color-text-secondary)] leading-relaxed mb-4">
          <span class="lang-fr">{item.descriptionFr}</span>
          <span class="lang-en">{item.descriptionEn}</span>
        </p>

        <div class="flex flex-wrap gap-1.5 pt-2 border-t border-[color:var(--color-border-light)]">
          {item.technologies.map((tech) => (
            <span class="sw-tag">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </div>
  ))}
</div>
